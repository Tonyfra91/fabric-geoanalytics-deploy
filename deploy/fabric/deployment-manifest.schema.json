{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nonsecret Fabric zombie outbreak deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deploymentName", "deploymentVersion", "subscriptionId", "tenantId",
    "resourceGroupName", "location", "userObjectId", "createdAt",
    "updatedAt", "stage", "resources", "capacityId", "capacityMode",
    "keyVaultName", "keyVaultUri", "keyVaultSecretName"
  ],
  "properties": {
    "deploymentName": { "type": "string" },
    "deploymentVersion": { "const": "0.1.0" },
    "subscriptionId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "format": "uuid" },
    "userObjectId": { "type": "string", "format": "uuid" },
    "resourceGroupName": { "type": "string" },
    "location": { "type": "string" },
    "capacityId": { "type": "string", "format": "uuid" },
    "capacityMode": { "enum": ["existing", "new"] },
    "workspaceId": { "type": "string", "format": "uuid" },
    "lakehouseId": { "type": "string", "format": "uuid" },
    "environmentId": { "type": "string", "format": "uuid" },
    "notebookId": { "type": "string", "format": "uuid" },
    "resultsNotebookId": { "type": "string", "format": "uuid" },
    "lastPreviewJobUri": { "type": "string", "pattern": "^https://api\\.fabric\\.microsoft\\.com/v1/" },
    "lastPreviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "grid_rows", "arrival_rows", "origin_rows", "svgPath"],
      "properties": {
        "run_id": { "type": "string" },
        "grid_rows": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "arrival_rows": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "origin_rows": { "const": 1 },
        "svgPath": { "type": "string" }
      }
    },
    "managedPrivateEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "targetPrivateLinkResourceId", "targetSubresourceType", "provisioningState", "approvalState"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "pattern": "^mpe-[a-zA-Z0-9-]+$", "maxLength": 64 },
        "targetPrivateLinkResourceId": { "type": "string", "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft\\.KeyVault/vaults/[^/]+/?$" },
        "targetSubresourceType": { "const": "vault" },
        "provisioningState": { "enum": ["Provisioning", "Updating", "Succeeded", "Failed", "Deleting"] },
        "approvalState": { "enum": ["Pending", "Approved", "Rejected", "Disconnected", null] }
      }
    },
    "keyVaultName": { "type": "string" },
    "keyVaultUri": { "type": "string", "pattern": "^https://[a-zA-Z0-9-]+\\.vault\\.azure\\.net/$" },
    "keyVaultSecretName": { "const": "geoanalytics-api-key" },
    "stage": { "enum": ["AzureDeployed", "Validating", "Configured"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "lastJobUri": { "type": "string", "pattern": "^https://api\\.fabric\\.microsoft\\.com/v1/" },
    "lastResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "outputs"],
      "properties": {
        "run_id": { "type": "string" },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["table", "rows"],
            "properties": {
              "table": { "type": "string" },
              "rows": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "created"],
        "properties": {
          "id": { "type": "string" },
          "created": { "type": "boolean" }
        }
      }
    }
  }
}
