{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "5537278644604394054"
    },
    "name": "Fast Pass GeoAnalytics credential",
    "description": "Stores the customer credential in the existing Key Vault through ARM without changing the vault or its networking."
  },
  "parameters": {
    "keyVaultName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Existing Fast Pass Key Vault name. Select its existing resource group."
      }
    },
    "geoAnalyticsApiKey": {
      "type": "securestring",
      "minLength": 1,
      "metadata": {
        "description": "Esri GeoAnalytics API key. Enter only in this secure deployment field, never in the template editor or a parameter file."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), 'geoanalytics-api-key')]",
      "properties": {
        "value": "[parameters('geoAnalyticsApiKey')]",
        "attributes": {
          "enabled": true
        }
      }
    }
  ]
}